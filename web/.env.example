# Copy this file to .env.local and fill in values from your Supabase project.
# Dashboard: Project Settings → API
#
# New projects issue a publishable key. Legacy anon keys still work as a
# compatibility fallback — never put the service_role / secret key here.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# HMAC secret used to sign the httpOnly participant session cookie.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# full = 300+ trial battery (~40 min). demo = short timelines for local testing.
NEXT_PUBLIC_EXPERIMENT_MODE=full
